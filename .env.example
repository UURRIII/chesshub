# ── Base de dades (usat per docker-compose) ──────────────────────────
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=chesshub
MYSQL_USER=chesshub
MYSQL_PASSWORD=change_me

# ── Backend i servidor de sockets ────────────────────────────────────
# JWT_SECRET ha de ser idèntic al backend i al socket-server perquè els
# tokens emesos per l'API es puguin verificar a la capa de temps real.
JWT_SECRET=una_cadena_aleatoria_llarga_de_com_a_minim_32_caracters

# Orígens permesos per CORS (separats per comes si n'hi ha més d'un)
ALLOWED_ORIGINS=http://localhost:4200

# URL del frontend (usada pel servidor de sockets)
FRONTEND_URL=http://localhost:4200
